<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="TestHelpers.fs" />
    <Compile Include="SchemaDsl.fs" />
    <Compile Include="PrintfEmissionTests.fs" />
    <Compile Include="SourceMapTests.fs" />
    <Compile Include="OpsPlatformJsTests.fs" />
    <Compile Include="PrimitiveExprTests.fs" />
    <Compile Include="FunctionEmissionTests.fs" />
    <Compile Include="RecordTests.fs" />
    <Compile Include="UnionMatchTests.fs" />
    <Compile Include="TupleTests.fs" />
    <Compile Include="OptionTests.fs" />
    <Compile Include="ListTests.fs" />
    <Compile Include="LibraryModeTests.fs" />
    <Compile Include="StructuralEqualityTests.fs" />
    <Compile Include="StructuralComparisonTests.fs" />
    <Compile Include="StructuralFormatTests.fs" />
    <Compile Include="MemberEmissionTests.fs" />
    <Compile Include="ExceptionTests.fs" />
    <Compile Include="ArrayLoopTests.fs" />
    <Compile Include="UseTests.fs" />
    <Compile Include="ForInTests.fs" />
    <Compile Include="ClassEmitTests.fs" />
    <Compile Include="StructuralFormatRecipeTests.fs" />
    <Compile Include="PrintfHoleFormTests.fs" />
    <Compile Include="StructuralPrinterTests.fs" />
    <Compile Include="PrintfSpecifierTests.fs" />
    <Compile Include="FreeFnOverloadTests.fs" />
    <Compile Include="ImportFormLoweringTests.fs" />
    <Compile Include="MemberOverloadTests.fs" />
    <Compile Include="TsManifestEnumTests.fs" />
    <Compile Include="EnumTests.fs" />
    <Compile Include="NullUndefinedTests.fs" />
    <Compile Include="DynamicTypeTests.fs" />
    <Compile Include="MethodAxisGenericTests.fs" />
    <Compile Include="MethodAxisSingleCandidateTests.fs" />
    <Compile Include="ExternalNominalClassTests.fs" />
    <Compile Include="ExternalHeritageTests.fs" />
    <Compile Include="LiteralUnionTests.fs" />
    <Compile Include="ExternalAttachMembersTests.fs" />
    <Compile Include="BusE2ETests.fs" />
    <Compile Include="MittE2ETests.fs" />
    <Compile Include="UnannotatedMittTests.fs" />
    <Compile Include="TypeLevelFoldTests.fs" />
    <Compile Include="UndefinedIdentityTests.fs" />
    <Compile Include="RefsTableTests.fs" />
    <Compile Include="StructuralShapeHashTests.fs" />
    <Compile Include="StructuralNominalTests.fs" />
    <Compile Include="JsNamespaceTests.fs" />
    <Compile Include="JsMapE2ETests.fs" />
    <Compile Include="IterableForInTests.fs" />
    <Compile Include="IntrinsicForwardReprJsTests.fs" />
    <Compile Include="NumberFamilyTests.fs" />
    <Compile Include="StructuralWidenTests.fs" />
    <Compile Include="OptionalParamTests.fs" />
    <Compile Include="IndexSignatureTests.fs" />
    <Compile Include="StructuralWidenE2ETests.fs" />
    <Compile Include="TypeArgNumberTests.fs" />
    <Compile Include="ExternMemberInlineTests.fs" />
    <Compile Include="ArrayIndexMemberTests.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Expecto" />
    <PackageReference Include="YoloDev.Expecto.TestSdk" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\XParsec.FSharp.SemanticAnalysis\XParsec.FSharp.SemanticAnalysis.fsproj" />
    <ProjectReference Include="..\..\src\XParsec.FSharp.Codegen.Js\XParsec.FSharp.Codegen.Js.fsproj" />
    <!-- The free-fn-overload erase test builds a synthetic provider
         from an in-memory TS manifest via `Vesper.Ts.Manifest.Codec`/`Schema`. -->
    <ProjectReference Include="..\..\src\Vesper.Ts.Manifest.Schema\Vesper.Ts.Manifest.Schema.fsproj" />
    <!-- The OpsPlatformJs tests build the JS-TARGET layer-1 harvest through the
         JS-native contract (`Codegen.Js.JsNativeSymbols`), so no dependency on the CLR
         backend is needed. The cross-target / CLR-repr contrasts (which need the BCL
         metadata leaf) live in `Codegen.Clr.Tests.OpsPlatformClrTests` instead. -->
    <ProjectReference Include="..\..\src\XParsec.FSharp.Codegen.Common\XParsec.FSharp.Codegen.Common.fsproj" />
  </ItemGroup>
</Project>
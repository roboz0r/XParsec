<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="TestHelpers.fs" />
    <Compile Include="PrintfEmissionTests.fs" />
    <Compile Include="SourceMapTests.fs" />
    <Compile Include="OpsPlatformJsTests.fs" />
    <Compile Include="Step1Tests.fs" />
    <Compile Include="Step2Tests.fs" />
    <Compile Include="Step3Tests.fs" />
    <Compile Include="Step4Tests.fs" />
    <Compile Include="Step5Tests.fs" />
    <Compile Include="Step5OptionImplTests.fs" />
    <Compile Include="Step5bTests.fs" />
    <Compile Include="Step5bPhase3Tests.fs" />
    <Compile Include="Step6Tests.fs" />
    <Compile Include="Step7Tests.fs" />
    <Compile Include="Step8Tests.fs" />
    <Compile Include="ArrayLoopTests.fs" />
    <Compile Include="UseTests.fs" />
    <Compile Include="ForInTests.fs" />
    <Compile Include="ClassEmitTests.fs" />
    <Compile Include="StructuralFormatRecipeTests.fs" />
    <Compile Include="PrintfHoleFormTests.fs" />
    <Compile Include="PrintfPhase3Tests.fs" />
    <Compile Include="PrintfPhase4Tests.fs" />
    <Compile Include="FreeFnOverloadTests.fs" />
    <Compile Include="MemberOverloadTests.fs" />
    <Compile Include="TsManifestEnumTests.fs" />
    <Compile Include="EnumTests.fs" />
    <Compile Include="NullUndefinedTests.fs" />
    <Compile Include="MethodAxisGenericTests.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Expecto" />
    <PackageReference Include="YoloDev.Expecto.TestSdk" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\XParsec.FSharp.SemanticAnalysis\XParsec.FSharp.SemanticAnalysis.fsproj" />
    <ProjectReference Include="..\..\src\XParsec.FSharp.Codegen.Js\XParsec.FSharp.Codegen.Js.fsproj" />
    <!-- The free-fn-overload erase test (Tier 2 item 9b) builds a synthetic provider
         from an in-memory TS manifest via `Vesper.Ts.Manifest.Codec`/`Schema`. -->
    <ProjectReference Include="..\..\src\Vesper.Ts.Manifest.Schema\Vesper.Ts.Manifest.Schema.fsproj" />
    <!-- The OpsPlatformJs tests build the JS-TARGET layer-1 harvest through the
         JS-native contract (`Codegen.Js.JsNativeSymbols`), so no dependency on the CLR
         backend is needed. The cross-target / CLR-repr contrasts (which need the BCL
         metadata leaf) live in `Codegen.Clr.Tests.OpsPlatformClrTests` instead. -->
    <ProjectReference Include="..\..\src\XParsec.FSharp.Codegen.Common\XParsec.FSharp.Codegen.Common.fsproj" />
  </ItemGroup>
</Project>
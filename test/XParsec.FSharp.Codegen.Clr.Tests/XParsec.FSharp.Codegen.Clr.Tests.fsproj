<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- The frozen pre-buffer `%A` engine, read as text + compiled through Codegen.Clr
         by `StructuralFormatBench` (the bench-structural entry); NOT fsc-compiled. -->
    <None Include="StructuralFormatBaseline.fs" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="TestHelpers.fs" />
    <Compile Include="PrintfHappyPathTests.fs" />
    <Compile Include="FSharpCoreDepsTests.fs" />
    <Compile Include="RunnableAppTests.fs" />
    <Compile Include="SelfHostTests.fs" />
    <Compile Include="ILIntrinsicTests.fs" />
    <Compile Include="OperatorRoutingTests.fs" />
    <Compile Include="ArithmeticOperatorTests.fs" />
    <Compile Include="OpsPlatformClrTests.fs" />
    <Compile Include="LiteralTests.fs" />
    <Compile Include="ComparisonTests.fs" />
    <Compile Include="BindingTests.fs" />
    <Compile Include="ControlFlowTests.fs" />
    <Compile Include="MatchTests.fs" />
    <Compile Include="FunctionTests.fs" />
    <Compile Include="ClosureTests.fs" />
    <Compile Include="UnionTests.fs" />
    <Compile Include="ListTests.fs" />
    <Compile Include="DiagnosticTests.fs" />
    <Compile Include="BitwiseOperatorTests.fs" />
    <Compile Include="LogicalOperatorTests.fs" />
    <Compile Include="StructuralEqualityTests.fs" />
    <Compile Include="StaticOptimizationTests.fs" />
    <Compile Include="HashTests.fs" />
    <Compile Include="IlIrTests.fs" />
    <Compile Include="MetadataSymbolsTests.fs" />
    <Compile Include="IntrinsicReprConformanceTests.fs" />
    <Compile Include="SymbolProviderWiringTests.fs" />
    <Compile Include="ExternalMemberTests.fs" />
    <Compile Include="RecordTests.fs" />
    <Compile Include="EqualityAttributeTests.fs" />
    <Compile Include="StructuralComparisonTests.fs" />
    <Compile Include="CustomEqualityComparisonDispatchTests.fs" />
    <Compile Include="CapturedMutableTests.fs" />
    <Compile Include="ClassTests.fs" />
    <Compile Include="ArityOverloadedClassTests.fs" />
    <Compile Include="StructTests.fs" />
    <Compile Include="ExceptionTests.fs" />
    <Compile Include="UseTests.fs" />
    <Compile Include="ForInTests.fs" />
    <Compile Include="StructSeqTests.fs" />
    <Compile Include="ChainedReceiverTests.fs" />
    <Compile Include="PackageBuildTests.fs" />
    <Compile Include="PackageBuildTriage.fs" />
    <Compile Include="ConformanceTyparsTests.fs" />
    <Compile Include="OptionTests.fs" />
    <Compile Include="ResultTests.fs" />
    <Compile Include="ChoiceTests.fs" />
    <Compile Include="ComparisonModuleTests.fs" />
    <Compile Include="ListModuleTests.fs" />
    <Compile Include="ArrayModuleTests.fs" />
    <Compile Include="SeqModuleTests.fs" />
    <Compile Include="SetModuleTests.fs" />
    <Compile Include="UseSetSampleTests.fs" />
    <Compile Include="CrossAssemblyEscapeTests.fs" />
    <Compile Include="LocalModuleTests.fs" />
    <Compile Include="InferResolutionTests.fs" />
    <Compile Include="TupleTests.fs" />
    <Compile Include="StructuralFormatTests.fs" />
    <Compile Include="PrintfDifferentialTests.fs" />
    <Compile Include="StructuralFormatBench.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Expecto" />
    <PackageReference Include="YoloDev.Expecto.TestSdk" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\XParsec.FSharp.SemanticAnalysis\XParsec.FSharp.SemanticAnalysis.fsproj" />
    <ProjectReference Include="..\..\src\XParsec.FSharp.Codegen.Common\XParsec.FSharp.Codegen.Common.fsproj" />
    <ProjectReference Include="..\..\src\XParsec.FSharp.Codegen.Clr\XParsec.FSharp.Codegen.Clr.fsproj" />
  </ItemGroup>
  <!--
    `StructuralFormatTests.fs` hand-writes `IFormatSink` / `IStructuralFormattable`
    impls; those interfaces are owned by `Vesper.Core`, so fsc needs the committed
    reference copy on its `-r` line (assembly references
    don't flow transitively through ProjectReferences). It is non-strong-named, so
    the loader unifies it with the backend-compiled `Vesper.Core` the in-process
    fixtures load into the Default ALC.
  -->
  <ItemGroup>
    <Reference Include="Vesper.Core">
      <HintPath>..\..\src\Vesper.Printf\refs\Vesper.Core.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
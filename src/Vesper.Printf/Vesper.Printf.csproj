<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Bootstrap runtime for Vesper.Printf (vesper-printf-plan P1). Hosts the
    write-through `Formatter` ref struct the CLR backend lowers a fully-applied
    literal `printf`/`printfn`/`sprintf` call to. Throwaway scaffolding behind a
    stable member-name seam: when Vesper self-hosts the handler, an `.fs` impl
    replaces this `.csproj` and the backend does not change. Consumed exactly
    like FSharp.Core — live-assembly identity in `ClrProvider`, copied next to
    the emitted PE by `Codegen.materialiseApp`.

    The `.fsi` files in this folder are the *front-end symbol contract* (parsed
    by XParsec.FSharp, not compiled here); only `Formatter.cs` is compiled.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Vesper.Printf</AssemblyName>
    <RootNamespace>Vesper</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Formatter.cs" />
    <Compile Include="StructuralFormat.cs" />
  </ItemGroup>
  <!--
    The `%A` structural-format interfaces (`Vesper.IFormatSink` /
    `Vesper.IStructuralFormattable`) are owned by `Vesper.Core`, so the synthesised
    record/DU `Format` implements a Core type and a
    record-bearing program never links `Vesper.Printf`. `Vesper.Core.dll` is built
    by *this repo's own backend* (no MSBuild project), so the cycle is broken with a
    committed, prebuilt reference copy: `RuntimeFormatState : IFormatSink` binds the
    Core-owned interface at C# build/design time. Regenerate `refs/Vesper.Core.dll`
    from the Vesper source via the `Vesper.Core reference copy is in sync` guard test
    (test/XParsec.FSharp.Codegen.Clr.Tests/SelfHostTests.fs). CopyLocal stays on so
    a downstream test bin (whose fsc-compiled `IFormatSink` impls need the type at
    load) finds it; it is non-strong-named, so the loader unifies it by name with the
    backend-compiled `Vesper.Core` the in-process fixtures load into the Default ALC.
  -->
  <ItemGroup>
    <Reference Include="Vesper.Core">
      <HintPath>refs\Vesper.Core.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
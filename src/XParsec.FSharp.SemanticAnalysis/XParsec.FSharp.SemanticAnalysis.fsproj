<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="EqArray.fs" />
    <Compile Include="EqSet.fs" />
    <Compile Include="EqDict.fs" />
    <Compile Include="Fifo.fs" />
    <Compile Include="Scc.fs" />
    <Compile Include="Compression.fs" />
    <Compile Include="RecordFieldClassifier.fs" />
    <Compile Include="Anchor.fs" />
    <Compile Include="NodeKey.fs" />
    <Compile Include="CstKeys.fs" />
    <Compile Include="OpenScope.fs" />
    <Compile Include="TypeDefnPatterns.fs" />
    <Compile Include="CstTypeWalk.fs" />
    <Compile Include="CstWalk.fs" />
    <Compile Include="CstModuleTree.fs" />
    <!-- Ahead of every reader of a `(# … #)` binding: the conformance check, the
         registrar and both front ends stitch the same instruction string through here. -->
    <Compile Include="IntrinsicBindings.fs" />
    <Compile Include="SymbolKeys.fs" />
    <Compile Include="SemanticScalars.fs" />
    <Compile Include="SemanticInfo.fs" />
    <!-- Immediately after the domain it interns: the frozen types and keys in ROW form,
         which the pool columns address by id and the codec stores. It reads `SemanticInfo`,
         the scalars, and `Anchor`'s `OriginFile` (a table of its own), nothing else. -->
    <Compile Include="FrozenTypeTable.fs" />
    <Compile Include="SemTypeWalks.fs" />
    <Compile Include="TypeStore.fs" />
    <Compile Include="FrozenTypeBridge.fs" />
    <Compile Include="GeneralizedTypars.fs" />
    <Compile Include="SymbolKeyOps.fs" />
    <Compile Include="SemTypeOps.fs" />
    <Compile Include="RuntimeNames.fs" />
    <Compile Include="OperatorNames.fs" />
    <Compile Include="AccessorNames.fs" />
    <Compile Include="UnionCaseFieldName.fs" />
    <Compile Include="AttributeDecode.fs" />
    <!-- After the attribute vocabulary it shares with the key-based reader: the CST reader
         here decodes the same `[<Import>]` arguments into the same shapes. -->
    <Compile Include="Conformance.fs" />
    <Compile Include="PrintfSpec.fs" />
    <Compile Include="PrintfHoleForm.fs" />
    <Compile Include="Diagnostics.fs" />
    <Compile Include="ParseChain.fs" />
    <Compile Include="SideTypes.fs" />
    <Compile Include="TastExpr.fs" />
    <Compile Include="AttributeVerdicts.fs" />
    <!-- After the frozen attribute model, which a binding's exportable identity carries. -->
    <Compile Include="ModuleBindingInfo.fs" />
    <Compile Include="TastDecl.fs" />
    <Compile Include="Tast.fs" />
    <!-- Immediately after the shapes it is a functor over, and BEFORE the pools: the
         pool fill/unpool reuse its type-declaration and compiled-form traversals rather
         than hand-rolling a second walk of those shapes. It depends on the shape files
         alone. -->
    <Compile Include="TastConvert.fs" />
    <Compile Include="TEnumCases.fs" />
    <!-- Ahead of the `.fsi` package extractor as well as the passes: both read the enum-case
         value grammar, so the reading is one function taking a token → text read. -->
    <Compile Include="StringLiterals.fs" />
    <!-- Ahead of every literal reader: the enum-case reader and the elaborator's literal
         projection both go through `ConstFold.tryLiteral`. -->
    <Compile Include="ConstFold.fs" />
    <Compile Include="EnumCaseValues.fs" />
    <Compile Include="TastWalk.fs" />
    <Compile Include="TastPoolNodes.fs" />
    <!-- Immediately after the `Wire` shapes it consumes and the `TastConvert` functor it
         routes over: the thaw is a function of a wire body and a position reading, and
         depends on nothing this side of the pools. -->
    <Compile Include="InlineThaw.fs" />
    <Compile Include="TastPoolTypes.fs" />
    <Compile Include="TastPoolShapes.fs" />
    <Compile Include="TastPools.fs" />
    <Compile Include="TastUnpool.fs" />
    <Compile Include="TastPoolBuilder.fs" />
    <!-- After the pools they read: every accessor body is a column read through a
         `PoolBuilder`, so the access seam depends on the pool, not the reverse. The
         shapes it hands back are declared first, holding pool handles and no reads. -->
    <Compile Include="TastNodeViews.fs" />
    <Compile Include="TastAccessor.fs" />
    <!-- After the pools: the codec serializes the POOL columns, so it depends on
         `TastPoolTypes`/`TastPools`, not the other way round. Its four modules are in
         layer order — stream/scalar primitives, then the type domain, then the declaration
         shell, then the columns `flatten`/`thaw` store — each reading only the ones above
         it. -->
    <Compile Include="FrozenCodecPrimitives.fs" />
    <Compile Include="FrozenCodecRows.fs" />
    <Compile Include="FrozenCodecDiagnostics.fs" />
    <Compile Include="FrozenCodecTypes.fs" />
    <Compile Include="FrozenCodecDecls.fs" />
    <Compile Include="FrozenCodec.fs" />
    <Compile Include="TastLower.fs" />
    <!-- The PARTS an external declaration is made of (a symbol, a member, a signature, a
         class or intrinsic surface), then the declaration SHAPE they compose into and the
         lookup contract that serves it. -->
    <Compile Include="ExternalDeclarations.fs" />
    <!-- Between the `IntrinsicPlatform` it is an axis of and the store contract that
         publishes it: the canon ↔ repr relation is a function of the declarations alone. -->
    <Compile Include="IntrinsicTypeMap.fs" />
    <Compile Include="ExternalSymbols.fs" />
    <!-- After the shape it builds and the case table it reads; shared by the frozen-file
         projection and the `.fsi` front end. -->
    <Compile Include="ExternalEnumShape.fs" />
    <Compile Include="ExternalSymbolProviders.fs" />
    <!-- Ahead of both producers that fill it: the frozen-file projection and the `.fsi`
         front end, both further down. -->
    <Compile Include="PublishedSurface.fs" />
    <!-- After the symbol data model it projects, and independent of everything below: an
         open method signature is a function of an `ExternalSymbol` alone. -->
    <Compile Include="MeasureErasure.fs" />
    <Compile Include="BuiltinTypes.fs" />
    <Compile Include="SourceFileKind.fs" />
    <Compile Include="SourceUnit.fs" />
    <Compile Include="ReferencedProject.fs" />
    <Compile Include="ParsedManifest.fs" />
    <Compile Include="ConformanceTypars.fs" />
    <!-- Beside the typar half it runs with: both compare a resolved signature surface
         against the implementation's frozen declarations. -->
    <Compile Include="ConformanceBodies.fs" />
    <Compile Include="ConformanceSurface.fs" />
    <Compile Include="FrozenSignature.fs" />
    <Compile Include="InlineBodies.fs" />
    <Compile Include="Intrinsics.fs" />
    <Compile Include="TypeInfos.fs" />
    <Compile Include="ScopeResolution.fs" />
    <Compile Include="TypeRegistry.fs" />
    <Compile Include="ModuleDeclarations.fs" />
    <Compile Include="ResolvedItem.fs" />
    <Compile Include="PassContext.fs" />
    <Compile Include="BaseEligibility.fs" />
    <Compile Include="LocalScope.fs" />
    <Compile Include="Containers.fs" />
    <Compile Include="AttributeResolution.fs" />
    <Compile Include="AttributeFold.fs" />
    <Compile Include="Containment.fs" />
    <Compile Include="MemberNames.fs" />
    <Compile Include="PropertyAccessors.fs" />
    <Compile Include="AssignTarget.fs" />
    <Compile Include="Passes\NameResolution\LongIdent.fs" />
    <Compile Include="Passes\NameResolution\TypeRefStamp.fs" />
    <!-- After name resolution: an attribute is decoded by RESOLVING its long-ident
         as a type, not by matching its short name. -->
    <Compile Include="Passes\Attributes.fs" />
    <Compile Include="Passes\Unification\EngineCore.fs" />
    <!-- Immediately after `zonk`, which every query here is asked through, and before any
         pass that asks one. It reads the engine core and the `SemType` shapes, nothing else. -->
    <Compile Include="SemTypeQuery.fs" />
    <!-- The one lookup behind a nominal key, local or published, which every layout and
         constraint verdict reads. After the engine core for its field substitution. -->
    <Compile Include="NominalDecl.fs" />
    <Compile Include="TypeLayout.fs" />
    <Compile Include="Passes\Unification\Subsume.fs" />
    <Compile Include="Passes\Unification\TraitMembers.fs" />
    <Compile Include="Passes\Unification\ConstraintCheck.fs" />
    <Compile Include="Passes\Unification\Engine.fs" />
    <Compile Include="Passes\Unification\Translate.fs" />
    <Compile Include="Passes\NameResolution\Scope.fs" />
    <Compile Include="Passes\NameResolution\TypeRegistration.fs" />
    <Compile Include="Passes\NameResolution\DeclRegistration.fs" />
    <Compile Include="Passes\NameResolution\UnionRegistration.fs" />
    <Compile Include="Passes\NameResolution\InheritParent.fs" />
    <Compile Include="Passes\NameResolution\TypeBodyExtraction.fs" />
    <Compile Include="Passes\NameResolution\MemberRegistration.fs" />
    <Compile Include="Passes\NameResolution.fs" />
    <Compile Include="Passes\Unification\RecursionComponents.fs" />
    <Compile Include="Passes\Unification\InferGeneralize.fs" />
    <Compile Include="Passes\Unification\InferLiterals.fs" />
    <Compile Include="Passes\Unification\InferResolve.fs" />
    <Compile Include="Passes\Unification\InferPat.fs" />
    <Compile Include="Passes\Unification\InferOverload.fs" />
    <Compile Include="Passes\Unification\InferForwardSchemes.fs" />
    <Compile Include="Passes\Unification\InferDispatch.fs" />
    <Compile Include="Passes\Unification\InferLiteralExpr.fs" />
    <Compile Include="Passes\Unification\InferRecordAccess.fs" />
    <Compile Include="Passes\Unification\InferExternalCall.fs" />
    <Compile Include="Passes\Unification\InferCtor.fs" />
    <Compile Include="Passes\Unification\InferTypeOps.fs" />
    <Compile Include="Passes\Unification\InferAssign.fs" />
    <Compile Include="Passes\Unification\InferControlFlow.fs" />
    <Compile Include="Passes\Unification\InferIdentExpr.fs" />
    <Compile Include="Passes\Unification\InferApp.fs" />
    <Compile Include="Passes\Unification\Infer.fs" />
    <Compile Include="Passes\Unification\ClassCtors.fs" />
    <Compile Include="Passes\Unification.fs" />
    <Compile Include="Passes\Regions.fs" />
    <Compile Include="Passes\Validation.fs" />
    <Compile Include="Elaborate\MemberKeys.fs" />
    <Compile Include="Inline.fs" />
    <Compile Include="Elaborate\Literals.fs" />
    <Compile Include="Elaborate\Nominals.fs" />
    <Compile Include="Elaborate\ObjArgs.fs" />
    <Compile Include="Elaborate\Calls.fs" />
    <Compile Include="Elaborate\Resolve.fs" />
    <Compile Include="Elaborate\Patterns.fs" />
    <Compile Include="Elaborate\Args.fs" />
    <Compile Include="Elaborate\Idents.fs" />
    <Compile Include="Elaborate\Strings.fs" />
    <Compile Include="Elaborate\Access.fs" />
    <Compile Include="Elaborate\Apply.fs" />
    <Compile Include="Elaborate\Printf.fs" />
    <Compile Include="ElaborateExpr.fs" />
    <Compile Include="Elaborate\Typars.fs" />
    <Compile Include="Elaborate\Members.fs" />
    <Compile Include="Elaborate\ClassMembers.fs" />
    <Compile Include="Elaborate\TypeDecls.fs" />
    <Compile Include="Passes\InlineSpecTable.fs" />
    <Compile Include="Passes\InlineReduction.fs" />
    <Compile Include="Passes\InlineExpansion.fs" />
    <Compile Include="Elaborate.fs" />
    <Compile Include="Passes\RefCellPromotion.fs" />
    <Compile Include="ResolvedTypes.fs" />
    <Compile Include="PlatformTypes.fs" />
    <Compile Include="DynamicEscape.fs" />
    <Compile Include="Freeze.fs" />
    <!-- After the passes whose resolver it drives and the typar-axis cut it freezes
         through, and before the driver that runs it beside them. -->
    <Compile Include="Passes\SignatureResolution\Context.fs" />
    <Compile Include="Passes\SignatureResolution\Members.fs" />
    <Compile Include="Passes\SignatureResolution.fs" />
    <Compile Include="Pipeline.fs" />
    <Compile Include="AssemblyFiles.fs" />
    <Compile Include="AssemblyAnalysis.fs" />
    <!-- After the `.fsi` front end and the per-file anchoring it shares with an assembly's
         units: a package is that same analysis over the files a manifest lists. -->
    <Compile Include="PackageProviders.fs" />
    <Compile Include="AssemblySources.fs" />
    <!-- After the sources it takes: `analyse` runs the front end over an `AssemblySources`. -->
    <Compile Include="AnalysedAssembly.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\XParsec.FSharp\XParsec.FSharp.fsproj" />
    <ProjectReference Include="..\XParsec.Toml\XParsec.Toml.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="System.IO.Hashing" />
  </ItemGroup>
</Project>
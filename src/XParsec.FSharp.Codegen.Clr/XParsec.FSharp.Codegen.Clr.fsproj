<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- Layer-2 .NET metadata reader (System.Reflection.MetadataLoadContext) and the
         CLR-side provider conveniences over the target-generic
         `Codegen.Common.SymbolProviders`. .NET-specific, so they live here, not in Common. -->
    <!-- TFM → reference-pack resolver: the no-MSBuild convenience over an explicit
         `dllPaths` set. Depends on nothing else in Codegen.Clr, so it sorts first. -->
    <Compile Include="RefPack.fs" />
    <Compile Include="MetadataSymbols.fs" />
    <Compile Include="ClrSymbolProviders.fs" />
    <Compile Include="ProjectInfo.fs" />
    <Compile Include="Types.fs" />
    <Compile Include="Cil.fs" />
    <Compile Include="Metadata.fs" />
    <Compile Include="ICodegenProvider.fs" />
    <Compile Include="CodegenSymbols.fs" />
    <Compile Include="ClrEnv.fs" />
    <Compile Include="IntrinsicRepr.fs" />
    <Compile Include="ClrEncoder.fs" />
    <Compile Include="ClrGenerics.fs" />
    <Compile Include="ClrExternalMembers.fs" />
    <Compile Include="ClrRecipes.fs" />
    <Compile Include="ClrProvider.fs" />
    <Compile Include="IlIr.fs" />
    <Compile Include="EmitTypes.fs" />
    <Compile Include="EmitLower.fs" />
    <Compile Include="EmitClosures.fs" />
    <Compile Include="EmitResolve.fs" />
    <Compile Include="ClrHoleFormat.fs" />
    <Compile Include="EmitFormat.fs" />
    <Compile Include="EmitDispatch.fs" />
    <Compile Include="EmitPattern.fs" />
    <Compile Include="EmitBindings.fs" />
    <Compile Include="EmitLoops.fs" />
    <Compile Include="EmitMatch.fs" />
    <Compile Include="EmitConstruct.fs" />
    <Compile Include="EmitMember.fs" />
    <Compile Include="EmitCall.fs" />
    <Compile Include="EmitIntrinsic.fs" />
    <Compile Include="EmitExpr.fs" />
    <Compile Include="EmitStructuralFormat.fs" />
    <Compile Include="Emit.fs" />
    <Compile Include="ModuleClassPlan.fs" />
    <Compile Include="CodegenTypes.fs" />
    <Compile Include="LayoutModel.fs" />
    <Compile Include="LayoutNodes.fs" />
    <Compile Include="Layout.fs" />
    <Compile Include="Materialise.fs" />
    <Compile Include="AssemblerScaffold.fs" />
    <Compile Include="ClosureVerdictRewrite.fs" />
    <Compile Include="Assembler.fs" />
    <Compile Include="NominalEmit.fs" />
    <Compile Include="Codegen.fs" />
    <!-- The library-level production CLR driver: parse/analyse/gate/emit against an
         explicit reference set. Sorts last — it composes everything above. -->
    <Compile Include="ClrDriver.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\XParsec.FSharp.SemanticAnalysis\XParsec.FSharp.SemanticAnalysis.fsproj" />
    <!-- Shared codegen symbol-resolution infra: `IntrinsicRepr` and the
         target-generic `SymbolProviders` (the .NET metadata reader `MetadataSymbols`
         is platform-specific and lives here in Codegen.Clr). -->
    <ProjectReference Include="..\XParsec.FSharp.Codegen.Common\XParsec.FSharp.Codegen.Common.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <!-- Layer 2 of the symbol-resolution stack: read referenced assemblies'
         metadata reflection-only (MetadataSymbols.fs). -->
    <PackageReference Include="System.Reflection.MetadataLoadContext" />
  </ItemGroup>
</Project>